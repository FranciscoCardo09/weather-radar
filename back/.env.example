# FIX: Configuración del backend mediante variables de entorno
# Copia este archivo como .env y ajusta los valores según tu entorno

# Puerto del servidor (1-65535)
PORT=8080

# URL del frontend para CORS
# IMPORTANTE: No usar "*" en producción cuando AllowCredentials=true
# Esto causaría una vulnerabilidad de seguridad CORS
FRONTEND_URL=http://localhost:5173

# Timeout para requests HTTP a la API externa Open-Meteo (en segundos)
# Rango válido: 1-60 segundos
# Recomendado: 10 para desarrollo, 5-8 para producción
API_TIMEOUT=10

# Rate limiting: requests permitidas por segundo
# Ajustar según capacidad del servidor y límites de la API externa
# Recomendado: 10 para desarrollo, 5-20 para producción
RATE_LIMIT=10

# Rate limiting burst: número máximo de requests en ráfaga
# Permite absorber picos temporales de tráfico
# Recomendado: 20 para desarrollo, 10-50 para producción
RATE_LIMIT_BURST=20
